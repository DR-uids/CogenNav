# CogenNav 配置（复制为 .env 后按需修改；全部可由环境变量覆盖）

# ── 运行期数据目录（默认 <仓库根>/.cogen）────────────────────────────
COGEN_HOME=.cogen
COGEN_HOST=127.0.0.1
COGEN_PORT=8765

# ── 索引规模与防护上限 ──────────────────────────────────────────────
COGEN_MAX_FILES=20000
COGEN_MAX_FILE_BYTES=1048576
COGEN_MAX_TOTAL_BYTES=2147483648
COGEN_CLONE_TIMEOUT_S=300
COGEN_PARSE_CHUNK_TIMEOUT_S=120
COGEN_PARSE_WORKERS=0          # 0 = cpu_count - 1

# ── 私有仓库 / 提高 API 配额（可选）─────────────────────────────────
# GITHUB_TOKEN=
# COGEN_GIT_TOKEN=

# ── LLM（OpenAI 兼容；不配置则 AI 功能降级为确定性实现）────────────
# COGEN_LLM_BASE_URL=https://api.deepseek.com/v1
# COGEN_LLM_API_KEY=
# COGEN_LLM_MODEL=deepseek-chat
COGEN_LLM_REDACT=1             # 上传给 LLM 的代码片段先做密钥脱敏

# ── 开发期缓存目录（Makefile 会自动设置，一般无需手填）──────────────
# PIP_CACHE_DIR=.cache/pip
# TMPDIR=.cache/tmp
# TREE_SITTER_LANGUAGE_PACK_CACHE_DIR=.cogen/cache/grammars
